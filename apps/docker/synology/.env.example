# AzerothCore Docker Configuration for Synology DSM 6.1.7
# Copy this file to .env and modify as needed

# ===========================================
# 镜像配置
# ===========================================
DOCKER_REGISTRY=registry.cn-hangzhou.aliyuncs.com/x014/
IMAGE_PREFIX=
DOCKER_IMAGE_TAG=latest

# ===========================================
# 数据库配置 (使用现有 MariaDB 10.3)
# ===========================================
DB_HOST=host.docker.internal
DB_PORT=3307
DB_USER=acore
DB_PASSWORD=acore

# ===========================================
# 服务器端口
# ===========================================
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878

# ===========================================
# 用户/组 ID (重要: 影响文件权限)
# 为空则使用 root (0:0)
# ===========================================
DOCKER_USER_ID=1026
DOCKER_GROUP_ID=100

# ===========================================
# 数据目录 (使用群晖绝对路径)
# ===========================================
DOCKER_VOL_ETC=./etc
DOCKER_VOL_LOGS=./logs
DOCKER_VOL_DATA=./data
